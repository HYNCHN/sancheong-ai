// 산청아이(AI) Cloudflare 설정 파일
// 이 파일은 고치지 않아도 됩니다.
{
  "name": "sancheong-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // 화면 파일(public 폴더)을 함께 올립니다. /api/ 로 시작하는 주소만 중계 서버가 처리합니다.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // 대시보드에서 넣은 설정값이 배포할 때 지워지지 않게 합니다.
  "keep_vars": true,
  // 익명 이용 통계 저장소 (날짜·학교·학년별 접속 수만 저장)
  "durable_objects": {
    "bindings": [{ "name": "STATS", "class_name": "Stats" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stats"] }]
}
